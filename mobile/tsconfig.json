{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["react"],
    "paths": {
      "*": ["./node_modules/*"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-native": ["./node_modules/react-native/types"],
      "react-native-safe-area-context": ["./node_modules/react-native-safe-area-context"],
      "react-native-markdown-display": ["./node_modules/react-native-markdown-display"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../features/src/**/*.ts",
    "../features/src/**/*.tsx",
    "../components/**/*.ts",
    "../components/**/*.tsx"
  ],
  "exclude": ["**/node_modules", "**/Pods"]
}
