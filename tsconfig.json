{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "rootDir": ".",
    "allowImportingTsExtensions": true
  },
  "include": [
    "tools/release/**/*.ts",
    "scripts/**/*.ts"
  ]
}
