{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "lib": ["esnext", "dom"],
    "types": [
      "react"
    ],
    "paths": {
      "*": [
        "./node_modules/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime"
      ],
      "react-native": [
        "./node_modules/react-native/types"
      ],
      "react-native-safe-area-context": [
        "./node_modules/react-native-safe-area-context"
      ],
      "@zijinhua/app-sdk": [
        "../../packages/app-sdk/src/index.ts"
      ],
      "@zijinhua/app-sdk/ui": [
        "../../packages/app-sdk/src/host-ui.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/features/**/*.ts",
    "../../packages/features/**/*.tsx",
    "../../packages/ui/**/*.ts",
    "../../packages/ui/**/*.tsx",
    "../../packages/platform/**/*.ts",
    "../../packages/app-sdk/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ]
}
