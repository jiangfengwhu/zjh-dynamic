{
  "name": "zjh-dynamic",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/mobile/tsconfig.json",
    "bundle": "tsx scripts/bundle-preview.ts",
    "publish": "tsx scripts/cloud-publish.ts",
    "build:sdk": "node scripts/build-sdk.mjs",
    "pack:sdk": "npm run build:sdk && npm pack ./packages/app-sdk --pack-destination dist",
    "publish:sdk": "npm run build:sdk && npm publish ./packages/app-sdk --access public --tag latest",
    "release:official": "tsx scripts/release-official.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.896.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "esbuild": "^0.28.2",
    "rollup": "^4.63.5",
    "rollup-plugin-dts": "^6.5.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
