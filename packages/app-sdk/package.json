{
  "name": "@zijinhua/app-sdk",
  "version": "1.0.0",
  "description": "Zijinhua application SDK and independent build/publish tools",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./creation": {
      "types": "./dist/creation.d.ts",
      "default": "./dist/creation.js"
    },
    "./platform.json": "./dist/platform.json",
    "./babel": "./dist/babel.cjs"
  },
  "bin": {
    "zjh-app": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangfengwhu/zjh-dynamic.git",
    "directory": "packages/app-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "19.2.3",
    "react-native": "0.87.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1139.0",
    "@babel/core": "7.29.7",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "metro": "0.87.1",
    "hermes-compiler": "250829098.0.17",
    "react-native-worklets": "0.13.0"
  }
}
